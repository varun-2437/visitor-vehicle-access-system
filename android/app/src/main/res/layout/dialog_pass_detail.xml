<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Visitor Gate Pass"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogPassId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="#VP-00084"
            android:textColor="@color/primary_crimson"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- QR Code Image -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Pass QR Code"
            android:scaleType="fitCenter" />
    </androidx.cardview.widget.CardView>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvDialogStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_in_campus"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="● IN CAMPUS"
        android:textColor="@color/status_in_campus"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Details Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/bg_input"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDialogVisitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visitor: Aarav Sharma"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogVehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vehicle: DL2CAY3180"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDialogPurpose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Purpose: Guest Visit"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDialogExpires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Valid Until: Nov 25, 2026 • 12:00 PM"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseDialog"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="@string/close"
        android:textColor="@color/primary_crimson"
        app:cornerRadius="8dp" />
</LinearLayout>
